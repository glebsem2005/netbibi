# Mode of operation: daemon | once | manual
MODE=daemon

# Logging
LOG_LEVEL=INFO

# Crawler settings (заглушки под будущий код)
NETBIBI_USER_AGENT=netbibi/0.0.0
NETBIBI_REQUEST_DELAY_MS=1000
NETBIBI_MAX_DEPTH=4
NETBIBI_DICTIONARY_PATH=/app/data/unique_words.csv

# Alerter integration. На VPS: скопировать ALERT_SHARED_TOKEN
# из /home/deploy/apps/alerter/.env (тот же, что у infra-watcher).
ALERTER_URL=http://alerter:8080/alert
ALERT_SHARED_TOKEN=
